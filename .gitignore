# ─────────────────────────────────────────────────────────────
#  Comprobantes reales — NUNCA al repositorio
#
#  Las facturas que usás para probar son documentos fiscales con
#  CUITs, montos y razones sociales reales de terceros. Este repo
#  es público (portfolio): publicarlas sería filtrar datos ajenos.
#
#  Versionados van solo los fixtures SINTÉTICOS, generados por el
#  propio proyecto a partir de la especificación del QR.
# ─────────────────────────────────────────────────────────────
fixtures-reales/
**/fixtures/reales/

# ── Maven ──
target/
pom.xml.versionsBackup
pom.xml.releaseBackup
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# ── Java ──
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
# ...pero el wrapper de Maven sí se versiona
!.mvn/wrapper/maven-wrapper.jar

# ── IDE ──
.idea/
*.iml
*.ipr
*.iws
# Anclados a la raiz con "/". Sin la barra inicial, "out/" matchea
# CUALQUIER directorio llamado out a cualquier profundidad, y se come
# adapters/out/, que es un paquete del codigo fuente. Pasa en silencio:
# compila local y el repo queda sin esos archivos.
/out/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
nbproject/
nb-configuration.xml

# ── Frontend (React + Vite) ──
node_modules/
/frontend/dist/
/frontend/dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Entorno y secretos ──
.env
.env.*
!.env.example
docker-compose.override.yml

# ── Datos locales de los contenedores ──
.docker-data/

# ── Logs ──
*.log
/logs/

# ── Sistema operativo ──
.DS_Store
Thumbs.db
desktop.ini
