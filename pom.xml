<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>ar.facturas</groupId>
  <artifactId>facturas-ar</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>facturas-ar</name>
  <description>Extracción automática de datos de comprobantes fiscales argentinos (ARCA)</description>

  <modules>
    <module>shared-domain</module>
    <module>extraction</module>
    <module>upload-api-service</module>
    <!-- shared-events y ocr-worker-service entran en la Fase 2, cuando
         exista la cola. Un módulo vacío durante seis semanas es ruido,
         no preparación. -->
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Terceros que Spring Boot no gestiona -->
    <zxing.version>3.5.3</zxing.version>
    <pdfbox.version>3.0.7</pdfbox.version>
    <tess4j.version>5.16.0</tess4j.version>
    <!--
      OpenCV viene de bytedeco y no de openpnp porque bytedeco compila
      con opencv_contrib, que es donde vive el detector de QR de WeChat.
      El build de openpnp es solo el core y no lo trae. Ver ADR 010.
    -->
    <opencv.version>4.10.0-1.5.11</opencv.version>
    <javacpp.version>1.5.11</javacpp.version>
    <openblas.version>0.3.28-1.5.11</openblas.version>
    <awssdk.version>2.46.7</awssdk.version>
  </properties>

  <!--
    Lombok para todos los módulos.

    `optional` para que no se propague a quien consuma estos jars: es un
    procesador de anotaciones en tiempo de compilación, no algo que haga
    falta en runtime.

    Importante dónde NO se usa: sobre entidades JPA están prohibidos
    @Data, @EqualsAndHashCode y @ToString. Los dos primeros generan
    equals/hashCode sobre todos los campos, lo que rompe con proxies lazy
    y con entidades dentro de un Set, y el tercero toca las relaciones
    lazy justo cuando estás logueando. equals/hashCode van escritos a
    mano, por identidad.
  -->
  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <!-- Módulos internos -->
      <dependency>
        <groupId>ar.facturas</groupId>
        <artifactId>shared-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>ar.facturas</groupId>
        <artifactId>extraction</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Lectura del QR de ARCA -->
      <dependency>
        <groupId>com.google.zxing</groupId>
        <artifactId>core</artifactId>
        <version>${zxing.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.zxing</groupId>
        <artifactId>javase</artifactId>
        <version>${zxing.version}</version>
      </dependency>

      <!-- Texto embebido y rasterizado de PDF -->
      <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>${pdfbox.version}</version>
      </dependency>

      <!-- OCR de último recurso -->
      <dependency>
        <groupId>net.sourceforge.tess4j</groupId>
        <artifactId>tess4j</artifactId>
        <version>${tess4j.version}</version>
      </dependency>
      <!--
        Las clases Java de OpenCV. Los binarios no vienen con este
        artefacto: se piden aparte, por classifier, en extraction/pom.xml.

        Se descarto `opencv-platform`, que es el meta-artefacto que los
        junta todos. La documentacion de bytedeco dice que la propiedad
        `javacpp.platform` lo acota a una sola plataforma; se probo y no
        lo hace cuando la propiedad se hereda de un pom padre:
        `dependency:tree` seguia resolviendo las diez. Pedir el
        classifier a mano es mas largo de leer pero no depende de que un
        perfil ajeno se active.

        numpy queda afuera: son los bindings de Python de OpenCV.
      -->
      <dependency>
        <groupId>org.bytedeco</groupId>
        <artifactId>opencv</artifactId>
        <version>${opencv.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.bytedeco</groupId>
            <artifactId>numpy</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <!-- Cliente S3 para MinIO -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
