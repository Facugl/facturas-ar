<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ar.facturas</groupId>
    <artifactId>facturas-ar</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>extraction</artifactId>
  <name>extraction</name>
  <description>Cascada de extracción: QR, texto embebido y OCR. Java puro, sin Spring.</description>

  <!--
    Módulo propio y sin Spring, por dos razones:

    1. Fase 1 lo usa upload-api-service y Fase 2 lo usa ocr-worker-service.
       Al vivir afuera de los dos, pasar de síncrono a asíncrono es agregar
       un deployable que lo envuelve, no mover código entre módulos.

    2. Es el núcleo del dominio: parsear una factura no debería saber que
       existe un framework. Las estrategias son clases comunes; quien las
       usa decide cómo instanciarlas.
  -->
  <dependencies>
    <dependency>
      <groupId>ar.facturas</groupId>
      <artifactId>shared-domain</artifactId>
    </dependency>

    <!--
      Estrategia 1: el QR de ARCA.

      Dos lectores, no uno. ZXing es Java puro y resuelve el PDF
      rasterizado; el detector de WeChat de OpenCV es el que lee las
      fotos, y medido sobre comprobantes reales leyo 4 de 6 donde ZXing
      leyo 1. Por que hay dos y no solo el segundo: ADR 010.
    -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>opencv</artifactId>
    </dependency>

    <!--
      Los binarios de OpenCV para Linux, sin perfil que los condicione.

      Van incondicionales a propósito. Antes colgaban de un perfil
      activado por SO y el CI de Linux se construyó sin ellos: OpenCV no
      cargó, las fotos dejaron de leerse y lo único que lo delató fue el
      test que compara contra la plataforma. Que la imagen de producción
      tenga su binario no puede depender de que un `<activation>` se
      dispare.

      El precio es que quien compile en Windows se baja ~44 MB de
      binarios de Linux que no va a usar. Barato al lado de descubrir en
      producción que el lector de fotos quedó inerte.
    -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>opencv</artifactId>
      <version>${opencv.version}</version>
      <classifier>linux-x86_64</classifier>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>openblas</artifactId>
      <version>${openblas.version}</version>
      <classifier>linux-x86_64</classifier>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacpp</artifactId>
      <version>${javacpp.version}</version>
      <classifier>linux-x86_64</classifier>
    </dependency>

    <!-- Estrategia 2: texto embebido. También rasteriza la página para buscarle el QR -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
    </dependency>

    <!-- Estrategia 3: OCR -->
    <dependency>
      <groupId>net.sourceforge.tess4j</groupId>
      <artifactId>tess4j</artifactId>
    </dependency>

    <!-- Parseo del JSON que viene dentro del QR -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    Los binarios para desarrollar en Windows.

    Este sí va en un perfil, y la diferencia con el bloque de Linux de
    arriba es deliberada: que la máquina de desarrollo tenga su binario
    es una comodidad, que lo tenga la imagen de producción es un
    requisito. Si este perfil no se activa, los tests de
    `WeChatQrEngineTest` se saltean y `reportsWhetherItCanRunAtAll` lo
    dice; si fallara el de Linux, se rompe el CI.

    Agregar una plataforma —macOS, arm64— es agregar un perfil igual a
    este con el classifier que corresponda.
  -->
  <profiles>
    <profile>
      <id>nativos-windows-x86_64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>opencv</artifactId>
          <version>${opencv.version}</version>
          <classifier>windows-x86_64</classifier>
        </dependency>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>openblas</artifactId>
          <version>${openblas.version}</version>
          <classifier>windows-x86_64</classifier>
        </dependency>
        <dependency>
          <groupId>org.bytedeco</groupId>
          <artifactId>javacpp</artifactId>
          <version>${javacpp.version}</version>
          <classifier>windows-x86_64</classifier>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

</project>
