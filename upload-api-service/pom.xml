<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ar.facturas</groupId>
    <artifactId>facturas-ar</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>upload-api-service</artifactId>
  <name>upload-api-service</name>
  <description>API de ingesta, revisión, historial y export.</description>

  <dependencies>
    <dependency>
      <groupId>ar.facturas</groupId>
      <artifactId>shared-domain</artifactId>
    </dependency>
    <!-- Repositorios y adapter de S3: los dos servicios pegan contra la
         misma base y el mismo bucket. Ver ADR 013. -->
    <dependency>
      <groupId>ar.facturas</groupId>
      <artifactId>shared-infrastructure</artifactId>
    </dependency>
    <!-- Contratos de los mensajes. Hoy solo los escribe el outbox;
         en la Fase 2 este mismo modulo lo lee el worker, y por eso el
         contrato no vive adentro de ninguno de los dos. -->
    <dependency>
      <groupId>ar.facturas</groupId>
      <artifactId>shared-events</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- El transporte de los eventos del outbox. Reemplaza al publisher
         in-process con el que nacio el outbox: el patron no cambia, solo
         quien lleva el mensaje. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <!-- Sin esto, /actuator/prometheus simplemente no existe: Actuator
         solo publica el endpoint si encuentra un registry en el classpath.
         Las metricas propias del dominio llegan en la Fase 3, pero el
         endpoint tiene que funcionar desde ahora porque application.yml
         ya lo declara expuesto. Config que promete algo que no esta es
         peor que no prometerlo. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Spring Boot 4 separó las autoconfiguraciones en un módulo por
         tecnología. Con flyway-core solo, Flyway queda en el classpath
         pero nadie lo arranca: la app levanta y no migra nada, sin un
         solo mensaje de error. El starter es el que trae el pegamento. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Escritura del CSV del export -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Postgres y el almacenamiento de objetos reales en los tests que los
      necesitan.

      Nada de H2: la mitad de lo que hay que probar acá es justamente lo
      que H2 no reproduce — el indice unico parcial de la deduplicacion,
      el UPDATE condicional del claim, los tipos JSON de field_sources, y
      que las migraciones de Flyway corran. Un test contra H2 pasa y no
      dice nada de si el sistema funciona.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers 2.x renombró los artefactos: en 1.x eran
         `junit-jupiter` y `postgresql` a secas. Spring Boot 4.1.1 importa
         el BOM 2.0.5, que solo conoce los nombres nuevos. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Un broker de verdad en los tests. Un RabbitTemplate mockeado no
         dice nada de lo unico que importa probar aca: que un mensaje sin
         ack vuelve, y que uno rechazado termina en la DLQ. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            El jar ejecutable sale con clasificador y el jar comun queda
            como artefacto principal.

            Por defecto `repackage` REEMPLAZA el artefacto principal por
            el ejecutable, y un jar ejecutable no sirve como dependencia:
            sus clases viven en BOOT-INF/classes y nadie las ve. Eso
            rompia la unica prueba automatica del criterio 8, que necesita
            levantar los dos servicios (ver el pom del worker).

            Consecuencia practica: el jar para correr es
            upload-api-service-<version>-boot.jar, no el que no tiene
            sufijo. El Dockerfile lo copia por nombre exacto por eso.
          -->
          <classifier>boot</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
