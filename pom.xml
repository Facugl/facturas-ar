<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>ar.facturas</groupId>
  <artifactId>facturas-ar</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>facturas-ar</name>
  <description>Extracción automática de datos de comprobantes fiscales argentinos (ARCA)</description>

  <modules>
    <module>shared-domain</module>
    <module>extraction</module>
    <module>shared-events</module>
    <module>shared-infrastructure</module>
    <module>upload-api-service</module>
    <module>ocr-worker-service</module>

    <!-- Los tres módulos `shared-*` nacieron cada uno cuando hubo dos
         lados que lo necesitaran, no antes: shared-domain con las
         entidades, shared-events con el outbox (que guarda el payload
         serializado, así que el contrato existe desde que existe la
         tabla) y shared-infrastructure al separar el worker. Un módulo
         vacío esperando su momento es ruido, no preparación. -->
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Terceros que Spring Boot no gestiona -->
    <zxing.version>3.5.3</zxing.version>
    <pdfbox.version>3.0.7</pdfbox.version>
    <tess4j.version>5.16.0</tess4j.version>
    <!--
      OpenCV viene de bytedeco y no de openpnp porque bytedeco compila
      con opencv_contrib, que es donde vive el detector de QR de WeChat.
      El build de openpnp es solo el core y no lo trae. Ver ADR 010.
    -->
    <opencv.version>4.10.0-1.5.11</opencv.version>
    <javacpp.version>1.5.11</javacpp.version>
    <openblas.version>0.3.28-1.5.11</openblas.version>
    <awssdk.version>2.46.7</awssdk.version>
    <commons-csv.version>1.14.1</commons-csv.version>
  </properties>

  <!--
    Lombok para todos los módulos.

    `optional` para que no se propague a quien consuma estos jars: es un
    procesador de anotaciones en tiempo de compilación, no algo que haga
    falta en runtime.

    Importante dónde NO se usa: sobre entidades JPA están prohibidos
    @Data, @EqualsAndHashCode y @ToString. Los dos primeros generan
    equals/hashCode sobre todos los campos, lo que rompe con proxies lazy
    y con entidades dentro de un Set, y el tercero toca las relaciones
    lazy justo cuando estás logueando. equals/hashCode van escritos a
    mano, por identidad.
  -->
  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <!-- Módulos internos -->
      <dependency>
        <groupId>ar.facturas</groupId>
        <artifactId>shared-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>ar.facturas</groupId>
        <artifactId>shared-events</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>ar.facturas</groupId>
        <artifactId>shared-infrastructure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>ar.facturas</groupId>
        <artifactId>extraction</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Lectura del QR de ARCA -->
      <dependency>
        <groupId>com.google.zxing</groupId>
        <artifactId>core</artifactId>
        <version>${zxing.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.zxing</groupId>
        <artifactId>javase</artifactId>
        <version>${zxing.version}</version>
      </dependency>

      <!-- Texto embebido y rasterizado de PDF -->
      <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>${pdfbox.version}</version>
      </dependency>

      <!-- OCR de último recurso -->
      <dependency>
        <groupId>net.sourceforge.tess4j</groupId>
        <artifactId>tess4j</artifactId>
        <version>${tess4j.version}</version>
      </dependency>
      <!--
        Las clases Java de OpenCV. Los binarios no vienen con este
        artefacto: se piden aparte, por classifier, en extraction/pom.xml.

        Se descarto `opencv-platform`, que es el meta-artefacto que los
        junta todos. La documentacion de bytedeco dice que la propiedad
        `javacpp.platform` lo acota a una sola plataforma; se probo y no
        lo hace cuando la propiedad se hereda de un pom padre:
        `dependency:tree` seguia resolviendo las diez. Pedir el
        classifier a mano es mas largo de leer pero no depende de que un
        perfil ajeno se active.

        numpy queda afuera: son los bindings de Python de OpenCV.
      -->
      <dependency>
        <groupId>org.bytedeco</groupId>
        <artifactId>opencv</artifactId>
        <version>${opencv.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.bytedeco</groupId>
            <artifactId>numpy</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <!--
        Escritura del CSV del export.

        Es la unica dependencia del proyecto que se podria reemplazar con
        un StringBuilder de diez lineas, y es justamente por eso que esta:
        ese StringBuilder funciona hasta que una razon social trae un
        punto y coma, unas comillas o un salto de linea, y ahi produce un
        archivo corrupto que nadie nota hasta que el usuario lo abre.
        Escapar CSV bien es un problema resuelto.
      -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-csv</artifactId>
        <version>${commons-csv.version}</version>
      </dependency>

      <!-- Cliente S3 para MinIO -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!--
              Los tests corren en UTC, siempre y en todas las maquinas.

              No es una preferencia: CI corre en UTC y esta laptop en
              UTC-3, y esa diferencia ya rompio dos veces. La segunda fue
              asi: el endpoint del historial convierte fechas usando la
              zona de Argentina (que es una decision del dominio, ver
              JobController.ZONE) y el test las convertia con la zona del
              sistema. O sea que el test afirmaba "esta maquina esta en
              Argentina" — pasaba local y fallaba en CI las tres horas
              por dia en que las dos zonas no coinciden sobre que dia es.
              La corrida que lo encontro arranco 02:22 UTC, que son las
              23:22 del dia anterior en Buenos Aires.

              Un test que falla el 13% de las veces es peor que uno que
              falla siempre: el intermitente se reintenta y se olvida.
              Con esto, cualquier supuesto sobre la zona del sistema se
              rompe en el primer `mvn test` de quien lo escribio, no de
              madrugada en el servidor de otro.
            -->
            <argLine>-Duser.timezone=UTC</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
