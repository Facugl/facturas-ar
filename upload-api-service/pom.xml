<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ar.facturas</groupId>
    <artifactId>facturas-ar</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>upload-api-service</artifactId>
  <name>upload-api-service</name>
  <description>API de ingesta, revisión, historial y export.</description>

  <dependencies>
    <dependency>
      <groupId>ar.facturas</groupId>
      <artifactId>shared-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>ar.facturas</groupId>
      <artifactId>shared-events</artifactId>
    </dependency>
    <!-- Fase 1: la API corre la cascada en el request.
         Fase 2: esta dependencia se va, la hereda el worker. -->
    <dependency>
      <groupId>ar.facturas</groupId>
      <artifactId>extraction</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Spring Boot 4 separó las autoconfiguraciones en un módulo por
         tecnología. Con flyway-core solo, Flyway queda en el classpath
         pero nadie lo arranca: la app levanta y no migra nada, sin un
         solo mensaje de error. El starter es el que trae el pegamento. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- MinIO vía el SDK de S3: el día que esto vaya a S3 real, no cambia el código -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
