  "cards": [
    {
      "dot": "cyan",
      "title": "Ingesta y lectura",
      "items": [
        "El frontend sube PDF/JPG/PNG y después hace polling de GET /jobs/:id",
        "Redis cachea esa lectura con TTL corto y se invalida al escribir, no se actualiza",
        "El export CSV por rango de fechas sale de la API, con formato Excel argentino"
      ]
    },
    {
      "dot": "emerald",
      "title": "Extracción en cascada",
      "items": [
        "1 · QR de ARCA con ZXing: fecha, CUIT, punto de venta, tipo, número, importe y CAE exactos",
        "2 · PDFBox sobre el texto embebido: razón social, neto e IVA",
        "3 · OpenCV + Tess4J solo para lo que siga faltando; ante discrepancia gana el QR"
      ]
    },
    {
      "dot": "rose",
      "title": "Confiabilidad",
      "items": [
        "El evento se escribe en la tabla outbox dentro de la transacción del Job: sin dual-write",
        "El worker toma el job con un UPDATE condicional desde PENDING: el duplicado hace ack sin trabajar",
        "Todo reproceso (DLQ, reaper de colgados, reintento manual) devuelve el Job a PENDING antes de republicar"
      ]
    },
    {
      "dot": "amber",
      "title": "Observabilidad",
      "items": [
        "Los dos servicios exponen /actuator/prometheus vía Micrometer",
        "La métrica principal es la tasa de detección de QR, con el origen de cada campo al lado",
        "Logs estructurados en JSON con el jobId como correlación"
      ]
    }
  ]
