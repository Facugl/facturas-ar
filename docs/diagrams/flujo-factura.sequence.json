  "cards": [
    {
      "dot": "cyan",
      "title": "Ingesta",
      "items": [
        "La API responde 202 apenas encola: el usuario nunca espera a la extracción",
        "El archivo va a MinIO y la cola solo transporta su storageKey",
        "El evento se escribe en la tabla outbox dentro de la misma transacción que el Job",
        "Un relay aparte lo publica a RabbitMQ, así no hay dual-write con el broker"
      ]
    },
    {
      "dot": "emerald",
      "title": "Extracción en cascada",
      "items": [
        "El QR obligatorio de ARCA (RG 4892) da siete campos exactos, sin OCR",
        "PDFBox cubre razón social, neto e IVA sobre el texto embebido del PDF",
        "El OCR queda de último recurso, solo para los campos que siguen vacíos",
        "Cada campo registra su fuente; ante discrepancia gana el QR"
      ]
    },
    {
      "dot": "rose",
      "title": "Revisión",
      "items": [
        "El formulario marca el origen de cada campo y protege los que vienen del QR",
        "Cada corrección queda en FieldCorrection como dataset de precisión",
        "Recién con CONFIRMED la factura entra al historial exportable"
      ]
    }
  ]
